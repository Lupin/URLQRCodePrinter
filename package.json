{
  "name": "url-qr-code-printer",
  "version": "0.1.0",
  "type": "module",
  "description": "Collect URLs from the browser, keep them in a local database, and print them as QR labels — sheet, CSV/Markdown export, or direct Niimbot D110 / M2 printing.",
  "keywords": [
    "qr-code",
    "label-printer",
    "niimbot",
    "browser-extension",
    "web-bluetooth",
    "safari-extension"
  ],
  "license": "MIT",
  "author": "Gaël Abegg-Gauthey <abegg.gauthey@gmail.com>",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "pretest": "node scripts/build.mjs",
    "test": "node --test 'test/*.test.js'",
    "test:swift": "node scripts/test-swift.mjs",
    "test:all": "npm test && npm run test:swift",
    "build": "node scripts/build.mjs",
    "build:web": "node scripts/build.mjs --only=web",
    "build:extension": "node scripts/build.mjs --only=extension",
    "icons": "node scripts/make-icons.mjs",
    "package:safari": "node scripts/package-safari.mjs",
    "package:chrome": "node scripts/package-chrome.mjs",
    "sync:safari": "node scripts/sync-safari-resources.mjs",
    "install:safari": "node scripts/install-safari.mjs",
    "open:extension": "node scripts/open-extension.mjs",
    "open:safari": "node scripts/open-extension.mjs --safari",
    "verify:brave": "node scripts/verify-brave.mjs",
    "verify:safari": "node scripts/verify-safari.mjs",
    "serve": "node scripts/serve.mjs",
    "dev": "node scripts/build.mjs && node scripts/serve.mjs"
  },
  "dependencies": {
    "uqr": "^0.1.3"
  }
}
