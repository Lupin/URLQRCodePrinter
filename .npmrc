# Le sandbox de fichiers de cette session n'autorise l'écriture que dans le
# workspace : le cache npm par défaut (~/.npm) est inaccessible et `npm install`
# échoue avec une erreur de chown trompeuse. On rapatrie donc cache ET journaux
# dans le projet. npm étend les variables d'environnement dans ce fichier.
cache=${PWD}/.npm-cache
logs-dir=${PWD}/.npm-cache/_logs
fund=false
audit=false
